{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Book Reader",
  "version": "0.1.0",
  "identifier": "com.hamzha.bookreader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Book Reader",
        "label": "main",
        "width": 1200,
        "height": 800,
        "minWidth": 860,
        "minHeight": 600,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' blob: data: http://book.localhost http://tauri.localhost http://localhost:1420; img-src 'self' blob: data: http://book.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval' blob:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost http://book.localhost http://localhost:1420 ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "fileAssociations": [
      { "ext": ["epub"], "name": "EPUB", "mimeType": "application/epub+zip", "description": "EPUB eBook" },
      { "ext": ["pdf"], "name": "PDF", "mimeType": "application/pdf", "description": "PDF" },
      { "ext": ["mobi"], "name": "MOBI", "mimeType": "application/x-mobipocket-ebook", "description": "MOBI eBook" },
      { "ext": ["azw"], "name": "AZW", "mimeType": "application/vnd.amazon.ebook", "description": "Kindle eBook" },
      { "ext": ["azw3"], "name": "AZW3", "mimeType": "application/vnd.amazon.ebook", "description": "Kindle eBook" },
      { "ext": ["fb2"], "name": "FB2", "mimeType": "application/x-fictionbook+xml", "description": "FictionBook" },
      { "ext": ["txt"], "name": "Text", "mimeType": "text/plain", "description": "Plain text" },
      { "ext": ["html", "htm"], "name": "HTML", "mimeType": "text/html", "description": "HTML" },
      { "ext": ["md", "markdown"], "name": "Markdown", "mimeType": "text/markdown", "description": "Markdown" },
      { "ext": ["rtf"], "name": "RTF", "mimeType": "application/rtf", "description": "Rich text" },
      { "ext": ["docx"], "name": "DOCX", "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "description": "Word document" },
      { "ext": ["djvu", "djv"], "name": "DJVU", "mimeType": "image/vnd.djvu", "description": "DjVu" },
      { "ext": ["cbz"], "name": "CBZ", "mimeType": "application/vnd.comicbook+zip", "description": "Comic book zip" },
      { "ext": ["cbr"], "name": "CBR", "mimeType": "application/vnd.comicbook-rar", "description": "Comic book rar" },
      { "ext": ["cb7"], "name": "CB7", "mimeType": "application/x-cb7", "description": "Comic book 7z" }
    ]
  }
}
